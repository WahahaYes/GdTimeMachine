addons/gut/
.addons/

# Logs and generated output
*.log

# Python
__pycache__/

# Git worktrees for showcase recording
.worktrees/

# GdTimeMachine local state (per-scene recording profiles, etc.)
addons/GdTimeMachine/config/state/*.cfg

# Captures
media/captures/
