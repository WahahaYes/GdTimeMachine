[node name="FormatWarningRow" type="HBoxContainer" parent="Split/RightColumn/SettingsGroup"]

[node name="FormatWarningLabel" type="Label" parent="Split/RightColumn/SettingsGroup/FormatWarningRow" unique_name_in_owner = true]
