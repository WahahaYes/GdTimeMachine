[node name="SceneLabel" type="Label" parent="Split/RightColumn/SettingsGroup/SceneRow" unique_name_in_owner = true]
custom_minimum_size = Vector2(60, 0)
text = "Scene:"

[node name="SceneEdit" type="LineEdit" parent="Split/RightColumn/SettingsGroup/SceneRow" unique_name_in_owner = true]
