[node name="UseCurrentButton" type="Button" parent="Split/RightColumn/SettingsGroup/SceneRow" unique_name_in_owner = true]
text = "Current"

[node name="FormatRow" type="HBoxContainer" parent="Split/RightColumn/SettingsGroup" unique_name_in_owner = true]
