[node name="BackendOption" type="OptionButton" parent="Split/RightColumn/BackendRow" unique_name_in_owner = true]
size_flags_horizontal = 3

[node name="SettingsGroup" type="VBoxContainer" parent="Split/RightColumn"]
theme_override_constants/separation = 2

[node name="SceneRow" type="HBoxContainer" parent="Split/RightColumn/SettingsGroup" unique_name_in_owner = true]
