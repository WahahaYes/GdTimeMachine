[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://addons/GdTimeMachine/ui/time_machine_dock.gd" id="1_dock"]

[node name="GdTimeMachine" type="VBoxContainer"]
theme_override_constants/separation = 6
script = ExtResource("1_dock")

[node name="Split" type="HBoxContainer" parent="."]
size_flags_vertical = 3

[node name="LeftColumn" type="VBoxContainer" parent="Split"]
size_flags_horizontal = 3
size_flags_stretch_ratio = 0.5
theme_override_constants/separation = 8

[node name="TitleIcon" type="TextureRect" parent="Split/LeftColumn" unique_name_in_owner = true]
custom_minimum_size = Vector2(154, 100)
size_flags_horizontal = 3
size_flags_vertical = 3
expand_mode = 1
stretch_mode = 5
mouse_filter = 2

[node name="PerSceneRow" type="HBoxContainer" parent="Split/LeftColumn"]
theme_override_constants/separation = 6

[node name="PerSceneCheck" type="CheckBox" parent="Split/LeftColumn/PerSceneRow" unique_name_in_owner = true]
size_flags_horizontal = 3
text = "Remember settings for this scene"

[node name="RecordButton" type="Button" parent="Split/LeftColumn" unique_name_in_owner = true]
custom_minimum_size = Vector2(0, 44)
size_flags_horizontal = 3
text = "Record"

[node name="RightColumn" type="VBoxContainer" parent="Split"]
size_flags_horizontal = 3
size_flags_stretch_ratio = 1.0
theme_override_constants/separation = 4

[node name="BackendRow" type="HBoxContainer" parent="Split/RightColumn"]
theme_override_constants/separation = 4

[node name="BackendLabel" type="Label" parent="Split/RightColumn/BackendRow"]
